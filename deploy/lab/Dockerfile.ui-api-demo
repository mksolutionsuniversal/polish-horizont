# OPT-IN synthetic SQLite UI; separate from 15480 preview and 15481 API.
FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/horizont/src

RUN addgroup -S -g 10001 horizont && \
    adduser -S -D -H -u 10001 -G horizont horizont

WORKDIR /opt/horizont
COPY src/horizont/ /opt/horizont/src/horizont/
COPY tools/generate_api_demo.py /opt/horizont/tools/generate_api_demo.py
COPY preview/index.html preview/app.js preview/styles.css /opt/horizont/preview/

RUN mkdir -p /opt/horizont/data && \
    python /opt/horizont/tools/generate_api_demo.py /opt/horizont/data/synthetic.sqlite && \
    chown -R 10001:10001 /opt/horizont

USER 10001:10001
EXPOSE 15482
CMD ["python", "-m", "horizont.ui_demo.server"]
