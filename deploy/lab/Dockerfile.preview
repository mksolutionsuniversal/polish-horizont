# Development-only static preview: no database, live providers or backend.
# This image is intentionally small, nonroot and offline at runtime.
FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN addgroup -S -g 10001 horizont && \
    adduser -S -D -H -u 10001 -G horizont horizont

WORKDIR /opt/horizont/preview
COPY --chown=10001:10001 preview/ ./
USER 10001:10001

EXPOSE 8080
CMD ["python", "-m", "http.server", "8080", "--bind", "0.0.0.0", "--directory", "/opt/horizont/preview"]
